<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Porthole</vendor>
  <vendor_url>https://porthole.sourceforge.net</vendor_url>

  <action id="org.porthole.run">
    <description>Run Porthole as administrator</description>
    <message>Authentication is required to manage packages with Porthole</message>
    <icon_name>porthole</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/porthole</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.porthole.update-check">
    <description>Check for updates now</description>
    <message>Authentication is required to sync and check for updates</message>
    <icon_name>porthole</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/porthole-update-service</annotate>
  </action>
</policyconfig>
