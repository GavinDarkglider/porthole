import os
import sys

if "--local" in sys.argv:
    # run from a source checkout
    sys.argv.remove("--local")
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from porthole.updater.notifier import main

sys.exit(main())
